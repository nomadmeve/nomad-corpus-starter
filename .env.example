# Nomad Corpus Platform Starter - Environment Configuration
# Copy this file to .env and adjust variables as needed.

# Gateway master session security token (Required PBKDF2 hash)
# Generate a new token with: npm run generate-token <your-password>
# Default dev password below: "devpassword"
DAO_CANON_GATE_TOKEN=pbkdf2.sha256.120000.OM3jQjWwNUUbNM_TS_AGOw.hpBIVTO07QZ9yEDZeO-BJKrKBiqitEUXTYXPBi2GuMU

# Target corpus host directory to mount into /corpus (Default: ./sample-corpus)
DAO_CANON_HOST_ROOT=./sample-corpus

# Corpus Identity (e.g. shizang, daocanon, yixue)
SOURCE_ID=shizang

# Service Port (Default: 3040 for API, 3080 for Gate)
HOST=0.0.0.0
PORT=3040
